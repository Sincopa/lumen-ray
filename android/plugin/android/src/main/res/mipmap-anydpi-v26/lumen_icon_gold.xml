<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon "gold": the full-bleed artwork under the launcher's mask; the
     monochrome layer is the round Lumen face for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lumen_icon_background" />
    <foreground android:drawable="@mipmap/lumen_icon_gold_foreground" />
    <monochrome>
        <inset
            android:drawable="@drawable/lumen_icon_face"
            android:inset="23%" />
    </monochrome>
</adaptive-icon>
