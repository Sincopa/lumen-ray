<?xml version="1.0" encoding="utf-8"?>
<!-- The application's own icon (Settings > Apps): the default gold face. The
     launcher entry itself comes from the icon the user picked in Lumen, one
     activity-alias per icon in the Lumen plugin. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lumen_icon_background" />
    <foreground android:drawable="@mipmap/lumen_icon_gold_foreground" />
    <monochrome>
        <inset
            android:drawable="@drawable/lumen_icon_face"
            android:inset="23%" />
    </monochrome>
</adaptive-icon>
