<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen launcher icon: the dark star sits inside the mask's safe zone on the
     icon's light grey; the monochrome layer is the status bar star for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lumen_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome>
        <inset
            android:drawable="@drawable/ic_lumen_status"
            android:inset="23%" />
    </monochrome>
</adaptive-icon>
