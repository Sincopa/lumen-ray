{
	"name": "lumen",
	"private": true,
	"version": "0.2.10",
	"description": "Desktop VPN and proxy client for Windows and macOS, built with Svelte 5 and Tauri 2",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"scripts": {
		"lint": "eslint src *.ts *.js --max-warnings 0",
		"format": "prettier --write src *.ts *.js *.json README.md",
		"format:check": "prettier --check src *.ts *.js *.json README.md",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/build/build-release.ps1 -Mode Installer",
		"build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/build/build-release.ps1 -Mode All",
		"build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/build/build-release.ps1 -Mode Installer",
		"build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/build/build-release.ps1 -Mode Portable",
		"prepare:core:macos": "sh src-tauri/build/prepare-core-macos.sh",
		"tauri:dev:macos": "sh src-tauri/build/prepare-core-macos.sh && tauri dev",
		"tauri:build:macos": "tauri build --target universal-apple-darwin",
		"build:macos": "tauri build --target universal-apple-darwin --config src-tauri/tauri.release.conf.json",
		"release:version": "node src-tauri/build/set-version.mjs"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "2.12.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"flag-icons": "^7.5.0",
		"jsqr": "^1.4.0",
		"lottie-web": "^5.13.0"
	}
}
